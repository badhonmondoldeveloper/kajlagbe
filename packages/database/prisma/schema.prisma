generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  SUSPENDED
  RESTRICTED
  DEACTIVATED
  INACTIVE
  PENDING_VERIFICATION
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED_OPTIONAL
  PENDING_REVIEW
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum NotificationType {
  ACCOUNT
  SECURITY
  BOOKING
  JOB
  MESSAGE
  PAYMENT
  SYSTEM
}

enum ActivityType {
  PROFILE_UPDATED
  SERVICE_ADDED
  AVAILABILITY_CHANGED
  ACCOUNT_STATUS_CHANGED
  BOOKING_CREATED
  JOB_CREATED
  PAYMENT_COMPLETED
  SECURITY_EVENT
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  phone             String?           @unique
  passwordHash      String?
  status            UserStatus        @default(PENDING_EMAIL_VERIFICATION)
  onboardingStatus  OnboardingStatus  @default(NOT_STARTED)
  isEmailVerified   Boolean           @default(false)
  isPhoneVerified   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  profile           UserProfile?
  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?
  businessProfile   BusinessProfile?
  userRoles         UserRole[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  activities        UserActivity[]
  savedProviders    SavedProvider[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([onboardingStatus])
  @@map("users")
}

model UserProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  avatarUrl          String?
  bio                String?
  address            String?
  divisionId         String?
  division           Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  districtId         String?
  district           District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazilaId          String?
  upazila            Upazila?           @relation(fields: [upazilaId], references: [id], onDelete: SetNull)
  verificationStatus VerificationStatus @default(NOT_STARTED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@map("user_profiles")
}

model CustomerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocations  String[]  @default([])
  serviceInterests    String[]  @default([])
  allowNotifications  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("customer_profiles")
}

model ProviderProfile {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryCategory     String
  secondaryCategories String[]             @default([])
  experienceYears     Int                  @default(1)
  bio                 String?
  serviceLocation     String?
  divisionId          String?
  districtId          String?
  skills              String[]             @default([])
  servicesOffered     Json?
  availabilityStatus  String               @default("available") // available, busy, away
  status              ProfileStatus        @default(PENDING_REVIEW)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  services            ProviderService[]
  portfolios          ProviderPortfolio[]
  availability        ProviderAvailability?

  @@index([primaryCategory])
  @@index([status])
  @@map("provider_profiles")
}

model ProviderService {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  name              String
  categorySlug      String
  description       String?
  pricingType       String          @default("fixed") // fixed, hourly, starting_from
  startingPrice     Decimal         @default(0) @db.Decimal(10, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([providerProfileId])
  @@index([categorySlug])
  @@map("provider_services")
}

model ProviderPortfolio {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  categorySlug      String
  images            String[]        @default([])
  projectDate       DateTime?
  isPublic          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([providerProfileId])
  @@map("provider_portfolios")
}

model ProviderAvailability {
  id                String          @id @default(uuid())
  providerProfileId String          @unique
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  status            String          @default("available") // available, busy, away
  isAutoAccept      Boolean         @default(false)
  workingHoursNote  String?
  customNotice      String?
  updatedAt         DateTime        @updatedAt

  @@map("provider_availabilities")
}

model BusinessProfile {
  id                  String                @id @default(uuid())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  tradeLicenseNumber  String?
  description         String?
  categories          String[]              @default([])
  teamSize            String                @default("1-5")
  contactPhone        String?
  contactEmail        String?
  businessAddress     String?
  divisionId          String?
  districtId          String?
  status              ProfileStatus         @default(PENDING_REVIEW)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  services            BusinessService[]
  locations           BusinessLocation[]
  teamMembers         BusinessTeamMember[]

  @@index([businessName])
  @@index([status])
  @@map("business_profiles")
}

model BusinessService {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  name              String
  categorySlug      String
  description       String?
  pricingModel      String          @default("quote") // fixed, starting_at, quote
  startingPrice     Decimal?        @db.Decimal(10, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@index([categorySlug])
  @@map("business_services")
}

model BusinessLocation {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  title             String
  divisionId        String?
  districtId        String?
  address           String
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@map("business_locations")
}

model BusinessTeamMember {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  name              String
  role              String          @default("TECHNICIAN") // OWNER, MANAGER, TECHNICIAN, STAFF
  phone             String?
  email             String?
  status            String          @default("ACTIVE") // ACTIVE, INACTIVE, PENDING_INVITE
  joinedAt          DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@map("business_team_members")
}

model SavedProvider {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerSlug String
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, providerSlug])
  @@index([userId])
  @@map("saved_providers")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model UserActivity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @default(PROFILE_UPDATED)
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("user_activities")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  module          String
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Division {
  id        String     @id @default(uuid())
  name      String     @unique
  bnName    String
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  districts District[]
  profiles  UserProfile[]

  @@map("divisions")
}

model District {
  id         String     @id @default(uuid())
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  bnName     String
  code       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  upazilas   Upazila[]
  profiles   UserProfile[]

  @@index([divisionId])
  @@map("districts")
}

model Upazila {
  id         String     @id @default(uuid())
  districtId String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String
  bnName     String
  code       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  profiles   UserProfile[]

  @@unique([districtId, name])
  @@index([districtId])
  @@map("upazilas")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
