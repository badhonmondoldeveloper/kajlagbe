generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  SUSPENDED
  RESTRICTED
  DEACTIVATED
  INACTIVE
  PENDING_VERIFICATION
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED_OPTIONAL
  PENDING_REVIEW
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum NotificationType {
  ACCOUNT
  SECURITY
  BOOKING
  JOB
  MESSAGE
  PAYMENT
  SYSTEM
}

enum ActivityType {
  PROFILE_UPDATED
  SERVICE_ADDED
  AVAILABILITY_CHANGED
  ACCOUNT_STATUS_CHANGED
  BOOKING_CREATED
  JOB_CREATED
  PAYMENT_COMPLETED
  SECURITY_EVENT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  UNDER_REVIEW
  PROVIDER_SELECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum JobUrgency {
  FLEXIBLE
  TODAY
  URGENT
  EMERGENCY_REQUEST
}

enum BudgetType {
  FIXED_BUDGET
  BUDGET_RANGE
  NEGOTIABLE
  REQUEST_QUOTES
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PricingType {
  FIXED
  HOURLY
  NEGOTIABLE
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  phone             String?           @unique
  passwordHash      String?
  status            UserStatus        @default(PENDING_EMAIL_VERIFICATION)
  onboardingStatus  OnboardingStatus  @default(NOT_STARTED)
  isEmailVerified   Boolean           @default(false)
  isPhoneVerified   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  profile           UserProfile?
  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?
  businessProfile   BusinessProfile?
  userRoles         UserRole[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  activities        UserActivity[]
  savedProviders    SavedProvider[]
  jobsPosted        Job[]             @relation("CustomerJobs")
  jobApplications   JobApplication[]  @relation("ProviderApplications")
  savedJobs         SavedJob[]
  statusHistories   JobStatusHistory[]
  customerBookings  Booking[]             @relation("CustomerBookings")
  providerBookings  Booking[]             @relation("ProviderBookings")
  customerWorkOrders WorkOrder[]          @relation("CustomerWorkOrders")
  providerWorkOrders WorkOrder[]          @relation("ProviderWorkOrders")
  rescheduleRequests BookingRescheduleRequest[]
  cancellations     BookingCancellation[]
  bookingHistories  BookingStatusHistory[]
  workOrderHistories WorkOrderStatusHistory[]
  progressUpdates   ServiceProgressUpdate[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  customerPayments         PaymentOrder[]            @relation("CustomerPayments")
  providerPayments         PaymentOrder[]            @relation("ProviderPayments")
  walletAccount            WalletAccount?
  payoutRequests           PayoutRequest[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([onboardingStatus])
  @@map("users")
}

model UserProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  avatarUrl          String?
  bio                String?
  address            String?
  divisionId         String?
  division           Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  districtId         String?
  district           District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazilaId          String?
  upazila            Upazila?           @relation(fields: [upazilaId], references: [id], onDelete: SetNull)
  verificationStatus VerificationStatus @default(NOT_STARTED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@map("user_profiles")
}

model CustomerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocations  String[]  @default([])
  serviceInterests    String[]  @default([])
  allowNotifications  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("customer_profiles")
}

model ProviderProfile {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryCategory     String
  secondaryCategories String[]             @default([])
  experienceYears     Int                  @default(1)
  bio                 String?
  serviceLocation     String?
  divisionId          String?
  districtId          String?
  skills              String[]             @default([])
  servicesOffered     Json?
  availabilityStatus  String               @default("available") // available, busy, away
  status              ProfileStatus        @default(PENDING_REVIEW)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  services            ProviderService[]
  portfolios          ProviderPortfolio[]
  availability        ProviderAvailability?

  @@index([primaryCategory])
  @@index([status])
  @@map("provider_profiles")
}

model ProviderService {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  name              String
  categorySlug      String
  description       String?
  pricingType       String          @default("fixed") // fixed, hourly, starting_from
  startingPrice     Decimal         @default(0) @db.Decimal(10, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([providerProfileId])
  @@index([categorySlug])
  @@map("provider_services")
}

model ProviderPortfolio {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  categorySlug      String
  images            String[]        @default([])
  projectDate       DateTime?
  isPublic          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([providerProfileId])
  @@map("provider_portfolios")
}

model ProviderAvailability {
  id                String          @id @default(uuid())
  providerProfileId String          @unique
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  status            String          @default("available") // available, busy, away
  isAutoAccept      Boolean         @default(false)
  workingHoursNote  String?
  customNotice      String?
  updatedAt         DateTime        @updatedAt

  @@map("provider_availabilities")
}

model BusinessProfile {
  id                  String                @id @default(uuid())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  tradeLicenseNumber  String?
  description         String?
  categories          String[]              @default([])
  teamSize            String                @default("1-5")
  contactPhone        String?
  contactEmail        String?
  businessAddress     String?
  divisionId          String?
  districtId          String?
  status              ProfileStatus         @default(PENDING_REVIEW)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  services            BusinessService[]
  locations           BusinessLocation[]
  teamMembers         BusinessTeamMember[]

  @@index([businessName])
  @@index([status])
  @@map("business_profiles")
}

model BusinessService {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  name              String
  categorySlug      String
  description       String?
  pricingModel      String          @default("quote") // fixed, starting_at, quote
  startingPrice     Decimal?        @db.Decimal(10, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@index([categorySlug])
  @@map("business_services")
}

model BusinessLocation {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  title             String
  divisionId        String?
  districtId        String?
  address           String
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@map("business_locations")
}

model BusinessTeamMember {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  name              String
  role              String          @default("TECHNICIAN") // OWNER, MANAGER, TECHNICIAN, STAFF
  phone             String?
  email             String?
  status            String          @default("ACTIVE") // ACTIVE, INACTIVE, PENDING_INVITE
  joinedAt          DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@map("business_team_members")
}

model SavedProvider {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerSlug String
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, providerSlug])
  @@index([userId])
  @@map("saved_providers")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model UserActivity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @default(PROFILE_UPDATED)
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("user_activities")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  module          String
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Division {
  id        String     @id @default(uuid())
  name      String     @unique
  bnName    String
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  districts District[]
  profiles  UserProfile[]

  @@map("divisions")
}

model District {
  id         String     @id @default(uuid())
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  bnName     String
  code       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  upazilas   Upazila[]
  profiles   UserProfile[]

  @@index([divisionId])
  @@map("districts")
}

model Upazila {
  id         String     @id @default(uuid())
  districtId String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String
  bnName     String
  code       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  profiles   UserProfile[]

  @@unique([districtId, name])
  @@index([districtId])
  @@map("upazilas")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Job {
  id                    String            @id @default(uuid())
  customerId            String
  customer              User              @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  categorySlug          String
  serviceSlug           String?
  requirements          String[]          @default([])
  urgency               JobUrgency        @default(FLEXIBLE)
  budgetType            BudgetType        @default(BUDGET_RANGE)
  budgetMin             Decimal?          @db.Decimal(10, 2)
  budgetMax             Decimal?          @db.Decimal(10, 2)
  status                JobStatus         @default(DRAFT)
  divisionId            String?
  districtId            String?
  generalArea           String
  privateAddress        String?
  preferredDate         String?
  preferredTime         String?
  selectedApplicationId String?
  selectedProviderId    String?
  cancellationReason    String?
  isPublic              Boolean           @default(true)
  publishedAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  applications          JobApplication[]
  statusHistories       JobStatusHistory[]
  savedBy               SavedJob[]
  booking               Booking?

  @@index([customerId])
  @@index([status])
  @@index([categorySlug])
  @@index([urgency])
  @@index([createdAt])
  @@map("jobs")
}

model JobApplication {
  id               String            @id @default(uuid())
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId       String
  provider         User              @relation("ProviderApplications", fields: [providerId], references: [id], onDelete: Cascade)
  coverLetter      String
  proposedPrice    Decimal           @db.Decimal(10, 2)
  pricingType      PricingType       @default(FIXED)
  estimatedDays    Int               @default(1)
  availabilityNote String?
  status           ApplicationStatus @default(SUBMITTED)
  isShortlisted    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  bookings         Booking[]

  @@unique([jobId, providerId])
  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@map("job_applications")
}

model JobStatusHistory {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus  JobStatus
  toStatus    JobStatus
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("job_status_histories")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SCHEDULED
  RESCHEDULE_REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED_FUTURE
  ARCHIVED
}

enum WorkOrderStatus {
  CREATED
  ASSIGNED
  SCHEDULED
  EN_ROUTE_FUTURE
  ARRIVED
  STARTED
  PAUSED
  COMPLETED_BY_PROVIDER
  CONFIRMED_BY_CUSTOMER
  CLOSED
  CANCELLED
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CancellationReason {
  CUSTOMER_CHANGED_MIND
  PROVIDER_UNAVAILABLE
  SCHEDULE_CONFLICT
  SERVICE_NO_LONGER_NEEDED
  PRICE_DISAGREEMENT
  DUPLICATE_REQUEST
  OTHER
}

enum LocationAccessState {
  LOCATION_HIDDEN
  LOCATION_AVAILABLE
  LOCATION_REVEALED
}

model Booking {
  id                  String              @id @default(uuid())
  bookingReference    String              @unique
  jobId               String              @unique
  job                 Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId       String
  application         JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customerId          String
  customer            User                @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  providerId          String
  provider            User                @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  status              BookingStatus       @default(PENDING_CONFIRMATION)
  agreedPrice         Decimal             @db.Decimal(10, 2)
  generalArea         String
  privateAddress      String?
  locationAccessState LocationAccessState @default(LOCATION_HIDDEN)
  scheduledDate       String?
  scheduledTime       String?
  durationNotes       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  confirmedAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  workOrder           WorkOrder?
  schedules           BookingSchedule[]
  rescheduleRequests  BookingRescheduleRequest[]
  cancellation        BookingCancellation?
  statusHistories     BookingStatusHistory[]
  progressUpdates     ServiceProgressUpdate[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingSchedule {
  id           String   @id @default(uuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedDate String
  proposedTime String
  isFlexible   Boolean  @default(false)
  notes        String?
  proposedById String
  isAccepted   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([bookingId])
  @@map("booking_schedules")
}

model BookingRescheduleRequest {
  id            String           @id @default(uuid())
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User             @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  currentDate   String?
  currentTime   String?
  proposedDate  String
  proposedTime  String
  reason        String
  status        RescheduleStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([bookingId])
  @@index([requestedById])
  @@index([status])
  @@map("booking_reschedule_requests")
}

model BookingCancellation {
  id             String             @id @default(uuid())
  bookingId      String             @unique
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledById  String
  cancelledBy    User               @relation(fields: [cancelledById], references: [id], onDelete: Cascade)
  reasonCategory CancellationReason
  note           String?
  previousStatus BookingStatus
  createdAt      DateTime           @default(now())

  @@index([bookingId])
  @@index([cancelledById])
  @@map("booking_cancellations")
}

model WorkOrder {
  id                  String           @id @default(uuid())
  workOrderReference  String           @unique
  bookingId           String           @unique
  booking             Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId          String
  customer            User             @relation("CustomerWorkOrders", fields: [customerId], references: [id], onDelete: Cascade)
  providerId          String
  provider            User             @relation("ProviderWorkOrders", fields: [providerId], references: [id], onDelete: Cascade)
  status              WorkOrderStatus  @default(CREATED)
  scopeSummary        String
  agreedPrice         Decimal          @db.Decimal(10, 2)
  startedAt           DateTime?
  providerCompletedAt DateTime?
  customerConfirmedAt DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  statusHistories     WorkOrderStatusHistory[]
  progressUpdates     ServiceProgressUpdate[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("work_orders")
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus
  toStatus    BookingStatus
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([bookingId])
  @@index([createdAt])
  @@map("booking_status_histories")
}

model WorkOrderStatusHistory {
  id          String          @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStatus  WorkOrderStatus
  toStatus    WorkOrderStatus
  changedById String?
  changedBy   User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime        @default(now())

  @@index([workOrderId])
  @@index([createdAt])
  @@map("work_order_status_histories")
}

model ServiceProgressUpdate {
  id          String          @id @default(uuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  status      WorkOrderStatus
  title       String
  note        String?
  images      String[]        @default([])
  createdAt   DateTime        @default(now())

  @@index([bookingId])
  @@index([workOrderId])
  @@index([createdAt])
  @@map("service_progress_updates")
}

// ==========================================
// MODULE 08: CHAT & COMMUNICATION SYSTEM
// ==========================================

enum ConversationContextType {
  DIRECT
  JOB_APPLICATION
  BOOKING
  WORK_ORDER
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id                    String                  @id @default(uuid())
  conversationReference String                  @unique
  contextType           ConversationContextType @default(DIRECT)
  jobId                 String?
  bookingId             String?
  workOrderId           String?
  lastMessageAt         DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  participants          ConversationParticipant[]
  messages              Message[]

  @@index([contextType])
  @@index([jobId])
  @@index([bookingId])
  @@index([workOrderId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  unreadCount    Int          @default(0)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType   @default(TEXT)
  content        String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attachments    MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  fileName  String
  fileSize  Int
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

// ==========================================
// MODULE 09: PAYMENTS, WALLET & REVENUE ENGINE
// ==========================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ONLINE_BKASH
  ONLINE_NAGAD
  ONLINE_CARDS
  CASH_ON_SERVICE
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  COMMISSION_FEE
  HOLD
  RELEASE
  PAYOUT
  REFUND
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

model PaymentOrder {
  id                 String        @id @default(uuid())
  orderReference     String        @unique
  bookingId          String?
  workOrderId        String?
  customerId         String
  customer           User          @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Cascade)
  providerId         String
  provider           User          @relation("ProviderPayments", fields: [providerId], references: [id], onDelete: Cascade)
  grossAmount        Decimal       @db.Decimal(10, 2)
  commissionAmount   Decimal       @db.Decimal(10, 2)
  netProviderAmount  Decimal       @db.Decimal(10, 2)
  paymentMethod      PaymentMethod @default(ONLINE_BKASH)
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  attempts           PaymentAttempt[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_orders")
}

model PaymentAttempt {
  id              String       @id @default(uuid())
  paymentOrderId  String
  paymentOrder    PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  gatewayProvider String       @default("BKASH")
  transactionId   String?      @unique
  status          PaymentStatus @default(PENDING)
  idempotencyKey  String       @unique
  rawPayload      String?
  createdAt       DateTime     @default(now())

  @@index([paymentOrderId])
  @@index([idempotencyKey])
  @@map("payment_attempts")
}

model PlatformCommissionConfig {
  id           String   @id @default(uuid())
  categorySlug String   @unique
  percentage   Decimal  @default(10.00) @db.Decimal(5, 2)
  fixedFee     Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_commission_configs")
}

model WalletAccount {
  id               String               @id @default(uuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Decimal              @default(0.00) @db.Decimal(10, 2)
  pendingBalance   Decimal              @default(0.00) @db.Decimal(10, 2)
  totalEarned      Decimal              @default(0.00) @db.Decimal(10, 2)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  ledgerEntries    WalletLedgerEntry[]

  @@index([userId])
  @@map("wallet_accounts")
}

model WalletLedgerEntry {
  id              String          @id @default(uuid())
  walletAccountId String
  walletAccount   WalletAccount   @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  amount          Decimal         @db.Decimal(10, 2)
  type            LedgerEntryType
  referenceId     String?
  description     String
  createdAt       DateTime        @default(now())

  @@index([walletAccountId])
  @@index([createdAt])
  @@map("wallet_ledger_entries")
}

model PayoutRequest {
  id             String       @id @default(uuid())
  providerId     String
  provider       User         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(ONLINE_BKASH)
  accountDetails String
  status         PayoutStatus @default(PENDING)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([providerId])
  @@index([status])
  @@map("payout_requests")
}



