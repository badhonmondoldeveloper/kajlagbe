NODE_ENV=development
PORT=4000

# Database (PostgreSQL / Supabase Database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kajlagbe?schema=public"

# Supabase Integration
SUPABASE_URL=https://epmbzwcvhophzhzetoio.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://epmbzwcvhophzhzetoio.supabase.co/auth/v1/.well-known/jwks.json

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis Cache (Future Integration)
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO / Cloudflare R2 - Future Integration)
STORAGE_ENDPOINT=
STORAGE_BUCKET=kajlagbe-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
